# FAYZ ATTOR — muhit o'zgaruvchilari namunasi
# Nusxa olib `.env` nomi bilan saqlang va qiymatlarni to'ldiring.
# `.env` hech qachon git'ga qo'shilmaydi.

# ---------- Baza (Neon.tech) ----------
# Pooled ulanish — ilova runtime'i uchun (hostda "-pooler" bo'ladi)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"
# Unpooled ulanish — migration uchun (hostdan "-pooler" olib tashlanadi)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"

# ---------- Auth ----------
# Har biri uchun: openssl rand -base64 48   yoki
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
ADMIN_JWT_SECRET=""

# ---------- Admin (seed uchun boshlang'ich hisob) ----------
# Seed shu ma'lumot bilan AdminUser yaratadi. Birinchi kirishdan keyin parolni o'zgartiring.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ---------- Cloudinary ----------
# cloudinary.com -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Brauzerda rasm URL'ini qurish uchun (maxfiy emas, cloud name takrorlanadi)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ---------- Telegram ----------
# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=""
# Vergul bilan ajratilgan chat ID'lar — har biriga buyurtma xabari yuboriladi.
# O'z ID'ingizni bilish uchun: botga yozing, keyin
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ADMIN_CHAT_IDS=""
# Webhook so'rovlari haqiqiyligini tekshirish uchun ixtiyoriy maxfiy satr
TELEGRAM_WEBHOOK_SECRET=""

# ---------- Sayt ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
